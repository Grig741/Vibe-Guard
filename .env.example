# VibeGuard configuration
# Copy to .env for local development: cp .env.example .env

# Database. Leave empty for local SQLite (vibeguard.db).
# On Railway, add a Postgres plugin — it injects DATABASE_URL automatically.
DATABASE_URL=

# Timeout (seconds) for each outbound probe request
SCAN_TIMEOUT=8

# Secret for /api/admin/* (issue license keys). Use a long random string.
# Leave empty to disable admin endpoints.
ADMIN_TOKEN=

# Where the "Get full report" button goes (Stripe Payment Link, Gumroad, Telegram…)
PAYMENT_URL=
# Price shown on the button
PRICE_LABEL=$9

# ---- Telegram (bot + Mini App + Stars payments) ----
# Token from @BotFather. Empty = Telegram features off.
BOT_TOKEN=
# Public https URL of this app. On Railway it's taken from RAILWAY_PUBLIC_DOMAIN automatically.
PUBLIC_URL=
# Full report price in Telegram Stars, and scans per purchase
STARS_PRICE=450
PACK_SCANS=10
# Shown on /paysupport — e.g. @your_username
SUPPORT_CONTACT=

# ---- Card / bank / crypto-wallet payments (confirmed by you) ----
# Leave EMPTY to send details yourself: reply to the bot's request and it forwards them to the buyer.
# Or set fixed details shown on the site (\n = new line).
MANUAL_DETAILS=
# Your Telegram ID — send /myid to the bot. Payment requests arrive here with ✅/❌ buttons.
ADMIN_TG_ID=
# Price in USD for transfers / crypto
PRICE_USD=9

# ---- Optional: automatic crypto via @CryptoBot ----
CRYPTOPAY_TOKEN=
CRYPTOPAY_TESTNET=false
